<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <KafkaAppender name="Kafka" topic="logs-topic">
            <PatternLayout pattern="%d{ISO8601} %-5p %c - %m%n"/>
            <Properties>
                <Property name="bootstrap.servers" value="localhost:9092"/>
                <Property name="client.id" value="demo-app"/>
            </Properties>
        </KafkaAppender>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{ISO8601} %-5p %c - %m%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Kafka"/>
        </Root>
    </Loggers>
</Configuration>
